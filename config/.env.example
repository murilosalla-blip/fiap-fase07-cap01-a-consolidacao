# ─────────────────────────────────────────────────────────────
# FarmTech Solutions — Grupo Aura | Fase 7
# Variáveis de ambiente
#
# Copie este arquivo para .env e preencha com seus valores reais:
#   cp config/.env.example config/.env
#
# NUNCA commite o arquivo .env no GitHub!
# ─────────────────────────────────────────────────────────────

# ── OpenWeatherMap ────────────────────────────────────────────
# Obtenha em: https://openweathermap.org/api (plano gratuito)
OPENWEATHER_API_KEY=sua_chave_openweather_aqui

# Localização da fazenda (usada como padrão na consulta de clima)
FAZENDA_CIDADE=Piracicaba
FAZENDA_PAIS=BR

# ── AWS SNS ───────────────────────────────────────────────────
# Credenciais da conta AWS (IAM user com permissão SNS)
AWS_ACCESS_KEY_ID=xxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxx
AWS_REGION=us-east-1

# ARN do tópico SNS criado na AWS
# Exemplo: arn:aws:sns:us-east-1:123456789012:farmtech-alertas
SNS_TOPIC_ARN=xxxxxxxx